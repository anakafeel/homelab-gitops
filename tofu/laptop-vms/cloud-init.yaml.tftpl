#cloud-config
hostname: ${hostname}
ssh_authorized_keys:
  - ${ssh_key}

# lab-autoscale.sh deletes the Node when it stops the VM. On the next boot the
# server rejects the cached kubelet certs ("unable to verify node identity") and
# k3s's token fallback fails, so drop them: the agent re-registers with its token.
write_files:
  - path: /etc/systemd/system/k3s-agent.service.d/fresh-node-certs.conf
    content: |
      [Service]
      ExecStartPre=-/bin/rm -f /var/lib/rancher/k3s/agent/client-kubelet.crt /var/lib/rancher/k3s/agent/client-kubelet.key /var/lib/rancher/k3s/agent/serving-kubelet.crt /var/lib/rancher/k3s/agent/serving-kubelet.key

# One script with set -e: if `tailscale up` fails (bad or unapproved key), stop
# there instead of installing k3s with an empty --node-ip.
runcmd:
  - - bash
    - -euc
    - |
      curl -fsSL https://tailscale.com/install.sh | sh
      tailscale up --auth-key='${tailscale_authkey}' --hostname=${hostname} --advertise-tags=tag:lab-node --timeout=120s
      ip=$(tailscale ip -4)
      # Agent talks to the Pi over the tailnet; flannel VXLAN rides tailscale0.
      curl -sfL https://get.k3s.io |
        INSTALL_K3S_VERSION='${k3s_version}' K3S_URL='${k3s_server}' K3S_TOKEN='${k3s_token}' \
        sh -s - agent \
        --node-ip "$ip" \
        --flannel-iface tailscale0 \
        --node-label homelab/lab=true \
        --node-taint homelab/lab=true:NoSchedule
