#cloud-config
hostname: ${hostname}
ssh_authorized_keys:
  - ${ssh_key}

# Power off 2h after every boot, so a forgotten VM frees RAM. A timer, not
# `shutdown +120` in bootcmd: that runs before D-Bus and powers off at once.
write_files:
  - path: /etc/systemd/system/lab-poweroff.timer
    content: |
      [Unit]
      Description=lab VM: automatic power-off 2h after boot
      [Timer]
      OnBootSec=2h
      Unit=poweroff.target
      [Install]
      WantedBy=timers.target

runcmd:
  - systemctl enable --now lab-poweroff.timer
  - curl -fsSL https://tailscale.com/install.sh | sh
  - tailscale up --auth-key='${tailscale_authkey}' --hostname=${hostname} --advertise-tags=tag:lab-node
  # Agent talks to the Pi over the tailnet; flannel VXLAN rides tailscale0.
  - >-
    curl -sfL https://get.k3s.io |
    INSTALL_K3S_VERSION='${k3s_version}' K3S_URL='${k3s_server}' K3S_TOKEN='${k3s_token}'
    sh -s - agent
    --node-ip "$(tailscale ip -4)"
    --flannel-iface tailscale0
    --node-label homelab/lab=true
    --node-taint homelab/lab=true:NoSchedule
