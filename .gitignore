# Never commit plaintext secrets. Encrypted secrets are *.sops.yaml (SOPS + age).
*.json
!renovate.json
# Grafana dashboards are plain config (no credentials)
!infra/monitoring/dashboards/*.json
*secret*.yaml
!*.sops.yaml

# local agent tooling state (ruflo)
.claude-flow/
.swarm/
agentdb.rvf*
ruvector.db

# OpenTofu: local caches, state and plans (state lives in the cluster / Garage)
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
