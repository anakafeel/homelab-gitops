      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "umami"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT coalesce(nullif(e.referrer_domain, ''), 'direct') AS referrer, count(DISTINCT e.visit_id) AS visits FROM website_event e WHERE event_type = 1 AND $__timeFilter(e.created_at) GROUP BY 1 ORDER BY 2 DESC LIMIT 20"
        }
      ]
    },
    {
      "id": 9,
