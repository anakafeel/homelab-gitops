      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "umami"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT coalesce(s.country, '?') AS country, count(DISTINCT e.session_id) AS visitors FROM website_event e JOIN session s USING (session_id) WHERE event_type = 1 AND $__timeFilter(e.created_at) GROUP BY 1 ORDER BY 2 DESC LIMIT 20"
        }
      ]
    }
