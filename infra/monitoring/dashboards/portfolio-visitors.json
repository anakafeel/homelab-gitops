    {
      "id": 5,
      "type": "timeseries",
      "title": "Page views and visitors",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "umami"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 1
          },
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "umami"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(e.created_at, $__interval), count(*) AS \"page views\", count(DISTINCT e.session_id) AS visitors FROM website_event e WHERE event_type = 1 AND $__timeFilter(e.created_at) GROUP BY 1 ORDER BY 1"
        }
      ]
    },
    {
      "id": 6,
      "type": "table",
      "title": "Recent page views",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "umami"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "umami"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT e.created_at AS \"time\", e.url_path AS page, coalesce(nullif(e.referrer_domain, ''), 'direct') AS referrer, s.country, s.region, s.city, s.device, s.browser, s.os, left(e.session_id::text, 8) AS visitor FROM website_event e JOIN session s USING (session_id) WHERE event_type = 1 AND $__timeFilter(e.created_at) ORDER BY e.created_at DESC LIMIT 200"
        }
      ]
    },
    {
      "id": 7,
      "type": "table",
      "title": "Top pages",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "umami"
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 0,
        "y": 24
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "umami"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT e.url_path AS page, count(*) AS views, count(DISTINCT e.session_id) AS visitors FROM website_event e WHERE event_type = 1 AND $__timeFilter(e.created_at) GROUP BY 1 ORDER BY 2 DESC LIMIT 20"
        }
      ]
    },
    {
      "id": 8,
      "type": "table",
      "title": "Referrers",
      "datasource": {
        "type": "grafana-postgresql-datasource",
