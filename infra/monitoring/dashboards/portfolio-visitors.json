  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Visitors",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "umami"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "umami"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(DISTINCT e.session_id) FROM website_event e WHERE event_type = 1 AND $__timeFilter(e.created_at)"
        }
      ]
    },
